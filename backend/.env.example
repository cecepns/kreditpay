PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kreditpay
JWT_SECRET=ganti-dengan-secret-yang-panjang-dan-acak
# Pisahkan dengan koma. Kosongkan untuk mengizinkan semua origin.
CORS_ORIGIN=http://localhost:5173

# Opsional: Native Web Push VAPID Keys (jika kosong, backend otomatis membuat & menyimpannya di app_settings)
# Generate manual via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@fastkredit.id
